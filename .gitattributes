# 统一换行符与编码，避免 Windows 协作时全文件 diff
* text=auto eol=lf

*.py    text eol=lf
*.ts    text eol=lf
*.vue   text eol=lf
*.js    text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.css   text eol=lf
*.html  text eol=lf

# Windows 脚本保留 CRLF
*.bat   text eol=crlf
*.ps1   text eol=crlf

# 二进制
*.pdf   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.mp4   binary
*.docx  binary
*.xlsx  binary

# 语言统计排除
package-lock.json  linguist-generated=true
