# ---- 应用 ----
APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=http://localhost:5173
REQUEST_TIMEOUT=120

# ---- 数据库 ----
# SQLite 必须开 WAL，代码会自动执行 PRAGMA，见 3.4 运行约束
DB_URL=sqlite+aiosqlite:///./data/app.db

# ---- 存储 ----
UPLOAD_DIR=./data/uploads
INDEX_DIR=./data/index
MAX_FILE_MB=20
MAX_PAGES=80

# ---- 模型服务（OpenAI 兼容）----
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TIMEOUT=60
LLM_MAX_RETRY=2
LLM_MAX_CONCURRENCY=3

EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=bge-m3
# EMBEDDING_DIM 不在此配置，由 build_index.py 探测并写入 data/index/meta.json

RERANK_ENABLED=false
RERANK_MODEL=

# ---- 检索参数 ----
RETRIEVE_TOP_K=20
RERANK_TOP_N=5
MIN_CONFIDENCE=0.6

# ---- 解析 ----
PARSE_TIMEOUT_SEC=10
OCR_ENABLED=false

# ---- 功能开关 ----
# DEMO_MODE=true 表示：模型不可用时返回固定示例结果，保证演示不崩
# 默认必须是 false。演示时用命令行前缀显式开启：DEMO_MODE=true uvicorn ...
DEMO_MODE=false
